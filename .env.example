# Copia este ficheiro para ".env" (mesma pasta) e substitui pelo teu token
# real. O .env nunca é enviado para o Git (está no .gitignore).
DISCORD_TOKEN=cola_aqui_o_token_do_teu_bot

# Opcional — ativa a API remota (usada pela app desktop em Justificativas →
# Bot remoto, para configurar o bot que está mesmo a correr aqui, em vez de a
# app abrir a sua própria ligação separada à Discord). Deixa comentado/vazio
# para manter a API desligada. Usa uma chave longa e aleatória — dá acesso de
# gestão ao bot a quem a tiver.
# LISDISCORD_API_KEY=gera_uma_chave_aleatoria_longa_aqui
# LISDISCORD_API_PORT=8787
